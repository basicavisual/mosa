{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://museumofstolenartefacts.org/schema/object.schema.json",
  "title": "MoSA collection object",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "foregroundedClaims"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "foregroundedClaims": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$|^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
